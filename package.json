{
  "name": "minibiz-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @minibiz-ai/shared build && pnpm -r --parallel --filter @minibiz-ai/shared --filter @minibiz-ai/frontend --filter @minibiz-ai/backend run dev",
    "dev:frontend": "pnpm --filter @minibiz-ai/frontend dev",
    "dev:backend": "pnpm --filter @minibiz-ai/backend dev",
    "build": "pnpm -r --filter @minibiz-ai/shared --filter @minibiz-ai/backend --filter @minibiz-ai/frontend run build",
    "start": "pnpm -r --parallel --filter @minibiz-ai/frontend --filter @minibiz-ai/backend run start",
    "lint": "pnpm -r --filter @minibiz-ai/frontend --filter @minibiz-ai/backend --filter @minibiz-ai/shared run lint"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
